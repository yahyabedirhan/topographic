{
  "name": "topography-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/react",
    "apps/generator"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && npm run build -w apps/generator",
    "build:packages": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p packages/react",
    "smoke": "node scripts/smoke.mjs",
    "dev": "npm run build:packages && npm run dev -w apps/generator"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "playwright-core": "^1.64.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  }
}

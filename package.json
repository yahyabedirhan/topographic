{
  "name": "topographic-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "workspaces": [
    "packages/core",
    "packages/react",
    "apps/playground"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs && npm run build -w apps/playground",
    "build:packages": "node scripts/build.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p packages/core && tsc -p packages/react",
    "smoke": "node scripts/smoke.mjs && node scripts/playground-check.mjs",
    "dev": "npm run build:packages && npm run dev -w apps/playground",
    "deploy": "npm run build && wrangler deploy",
    "marketing": "npm run build:packages && vite --config docs/prototypes/marketing/vite.config.mjs --open /docs/prototypes/marketing/"
  },
  "devDependencies": {
    "esbuild": "^0.24.0",
    "happy-dom": "^21.0.3",
    "playwright-core": "^1.64.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0",
    "wrangler": "^4.151.1"
  }
}

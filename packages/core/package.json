{
  "name": "topographic",
  "version": "0.1.0",
  "description": "A JavaScript package for creating animated topographic backgrounds.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yahyabedirhan/topography.git",
    "directory": "packages/core"
  },
  "homepage": "https://yahyabedirhan.github.io/topography/",
  "bugs": {
    "url": "https://github.com/yahyabedirhan/topography/issues"
  },
  "keywords": [
    "topography",
    "topographic",
    "contour",
    "background",
    "webgl",
    "shader",
    "animated-background",
    "web-component"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/element.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "topographic",
  "version": "0.5.0",
  "description": "Animated topographic contour backgrounds for the web, in 2D or as a 3D terrain. Seven styles, real elevation data through setHeightfield(), automatic quality tiers, PNG and video export, no dependencies.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yahyabedirhan/topographic.git",
    "directory": "packages/core"
  },
  "homepage": "https://topographic.yahyapak.dev",
  "bugs": {
    "url": "https://github.com/yahyabedirhan/topographic/issues"
  },
  "keywords": [
    "topography",
    "topographic",
    "contour",
    "contour-lines",
    "background",
    "animated-background",
    "webgl",
    "shader",
    "3d",
    "terrain",
    "heightmap",
    "elevation",
    "dem",
    "map",
    "quality-tiers",
    "webmcp",
    "web-component"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/element.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "import": "./dist/element.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "publishConfig": {
    "access": "public"
  }
}

{
  "name": "topographic-react",
  "version": "0.7.0",
  "description": "React component for topographic. Generate a land or turn a real place into a topographic terrain, rendered with WebGL.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yahyabedirhan/topographic.git",
    "directory": "packages/react"
  },
  "homepage": "https://topographic.yahyapak.dev",
  "bugs": {
    "url": "https://github.com/yahyabedirhan/topographic/issues"
  },
  "keywords": [
    "react",
    "react-component",
    "hooks",
    "topographic",
    "topography",
    "topographic-map",
    "contour",
    "contour-lines",
    "isolines",
    "terrain",
    "terrain-generation",
    "procedural",
    "procedural-generation",
    "heightmap",
    "heightfield",
    "webgl",
    "3d"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",

{
  "name": "topographic-react",
  "version": "0.4.0",
  "description": "React component and hook for topographic: animated contour backgrounds in 2D or as a 3D terrain, with real elevation data, styles and automatic quality tiers.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yahyabedirhan/topographic.git",
    "directory": "packages/react"
  },
  "homepage": "https://topographic.yahyapak.dev",
  "bugs": {
    "url": "https://github.com/yahyabedirhan/topographic/issues"
  },
  "keywords": [
    "topography",
    "topographic",
    "contour",
    "contour-lines",
    "background",
    "animated-background",
    "webgl",
    "shader",
    "3d",
    "terrain",
    "heightmap",
    "elevation",
    "dem",
    "map",
    "quality-tiers",
    "webmcp",
    "react",
    "react-component"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "dependencies": {
    "topographic": "^0.4.0"
  },
  "peerDependencies": {

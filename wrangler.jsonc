// Cloudflare Worker that serves the built playground as static assets.
// Files come from apps/playground/dist, and apps/playground/public/_headers
// (copied into dist) sets their headers. worker/index.js answers only the
// requests that match no file and are not a browser navigation, with a 404.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "topographic",
  "compatibility_date": "2026-10-17",
  "main": "./worker/index.js",
  // Cloudflare creates the DNS record and certificate for this hostname.
  "routes": [{ "pattern": "topographic.yahyapak.dev", "custom_domain": true }],
  "assets": {
    "directory": "./apps/playground/dist",
    // The playground keeps its state in the query string, so a browser that
    // navigates to an unknown path gets index.html. Other requests reach the script.
    "not_found_handling": "single-page-application"
  }
}

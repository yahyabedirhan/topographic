---
// Every page's document: the head from src/meta.ts (title, description, canonical address and share image), the
// fonts, the client router that moves between /, /about and /docs without a full load, and the start-up script.
import { ClientRouter } from 'astro:transitions';
import type { PageMeta } from '../meta';
import '../style.css';

interface Props { page: PageMeta }
const { page } = Astro.props;
const base = import.meta.env.BASE_URL;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="data:," />
    <slot name="head" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {/* One stylesheet for every page, so a page change loads no new fonts: the docs use Inter 600 and JetBrains Mono. */}
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&family=Literata:opsz,wght@7..72,600&display=swap" rel="stylesheet" />
    <title>{page.title}</title>
    <link rel="alternate" type="text/plain" href={`${base}llms.txt`} title="LLM docs" />
    <meta name="description" content={page.description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="topographic" />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    <link rel="canonical" href={page.url} />
    <meta property="og:url" content={page.url} />
    <meta property="og:image" content={page.image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={page.imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={page.title} />
    <meta name="twitter:description" content={page.description} />
    <meta name="twitter:image" content={page.image} />
    <meta name="twitter:image:alt" content={page.imageAlt} />
    {/* Browsers without the View Transition API get Astro's own animation. */}
    <ClientRouter fallback="animate" />
  </head>
  <body>
    <slot />
    <script>
      import '../boot';
    </script>
  </body>
</html>
